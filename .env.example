# Server
PORT=3000

# Firebase project (chatapp-f13c1)
FIREBASE_PROJECT_ID=chatapp-f13c1

# Firebase Admin SDK service account credentials.
# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@chatapp-f13c1.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Alternative to the two vars above: paste the whole downloaded service
# account JSON file as a single line and set this instead.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"chatapp-f13c1",...}

# Web API key used by POST /auth/login to sign in with email/password via the
# Identity Toolkit REST API (the Admin SDK cannot verify passwords itself).
# Firebase Console > Project settings > General > Web API Key
FIREBASE_API_KEY=

# Optional: credentials for the admin user created by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password123
